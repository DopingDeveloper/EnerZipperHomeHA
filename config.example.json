  "mqtt": {
    "host": "mqtt.example.internal",
    "port": 1883,
    "username_env": "ENERZIPPER_MQTT_USERNAME",
    "password_env": "ENERZIPPER_MQTT_PASSWORD",
    "tls": false,
    "ca_file": null
  }
}
